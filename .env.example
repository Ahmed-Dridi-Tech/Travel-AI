# --- App ---
APP_NAME=travel-ai
APP_ENV=development            # development | test | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:8501,http://localhost:3000   # comma-separated

# --- Database (PostgreSQL) ---
POSTGRES_USER=travel_ai_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full URL overrides the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg://travel:change-me@localhost:5432/travel_ai

# --- LLM ---
LLM_PROVIDER=mock              # mock | anthropic | gemini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOOL_ITERATIONS=4
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- External APIs ---
OPENWEATHER_API_KEY=your-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org
EXCHANGE_RATE_API_KEY=your-key-here
EXCHANGERATE_BASE_URL=https://v6.exchangerate-api.com/v6
HTTP_TIMEOUT_SECONDS=8
CACHE_TTL_WEATHER_SECONDS=900
CACHE_TTL_EXCHANGE_SECONDS=3600

# --- NLP ---
FASTTEXT_MODEL_PATH=data/models/lid.176.bin
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
INTENT_MODEL_PATH=data/models/intent_classifier.pkl
INTENT_LABELS_PATH=data/models/intent_labels.pkl
INTENT_CONFIG_PATH=data/models/intent_config.json
GAZETTEER_PATH=data/destinations_gazetteer.json
SPACY_MODEL_NAME=xx_ent_wiki_sm
INTENT_CONFIDENCE_THRESHOLD=0.45
OOD_THRESHOLD=0.35

# --- Frontend (Streamlit) ---
API_BASE_URL=http://localhost:8000
DASHBOARD_PASSWORD=change-this-before-demo

# --- Deployment (Railway) ---
# On the API service set USE_MOCK_NLP=true (no ML packages on the free tier). DATABASE_URL is provided by Railway.
USE_MOCK_NLP=false
# When set, GET /api/v1/analytics requires header X-API-Key; set the SAME value on the Streamlit service.
ANALYTICS_API_KEY=
